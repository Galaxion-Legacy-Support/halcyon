<?xml version="1.0" encoding="utf-8"?>
<!-- Package feeds for "nuget restore Halcyon.sln". Halcyon.Whip.Client comes
     from the Galaxion-Legacy-Support feed on GitHub Packages, which needs a
     sign-in: see THIRD-PARTY.md. Never put a token in this file. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="galaxion-legacy-support" value="https://nuget.pkg.github.com/Galaxion-Legacy-Support/index.json" />
  </packageSources>
</configuration>
