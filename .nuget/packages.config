  <package id="Halcyon.Whip.Client" version="1.2.0" />
  <package id="log4net" version="2.0.17" />
  <package id="Mono.Addins" version="1.0.0" />
  <package id="openstack.net" version="1.3.2" />
  <package id="SimpleRESTServices" version="1.3.0.1" />
  <package id="System.Collections.Immutable" version="1.1.37" />
  <package id="System.Data.SQLite.Core" version="1.0.98" />
  <package id="Thrift" version="0.6.0" />
  <package id="zlib.net" version="1.0.3" />
</packages>
